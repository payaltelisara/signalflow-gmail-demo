APP_ENV=development
DATABASE_URL=postgresql+psycopg://signalflow:signalflow@postgres:5432/signalflow
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=signalflow
MINIO_SECRET_KEY=signalflow-local-only
MINIO_BUCKET=signalflow
SESSION_SECRET=change-me-before-any-non-local-use
DEV_ADMIN_EMAIL=admin@signalflow.local
DEV_ADMIN_PASSWORD=change-me-local-password
MAX_UPLOAD_BYTES=20971520
MAX_IMPORT_ROWS=50000
AI_ENABLED=true
AI_REQUIRED=true
OLLAMA_BASE_URL=http://host.containers.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_MAX_CONCURRENCY=2
AI_MAX_INPUT_CHARACTERS=6000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
PUBLIC_APP_URL=http://localhost:8080
# Generate locally with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
# Create an OAuth 2.0 Web application in Google Cloud. Never commit real values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/v1/integrations/gmail/callback
# Default is scheduled Gmail History API polling. Set true only to safely exercise test delivery logic.
GMAIL_POLL_INTERVAL_SECONDS=300
GMAIL_TEST_MODE=false
# Free SMTP/IMAP mailbox adapter. For Gmail, use an App Password generated in
# your Google Account after enabling two-step verification. Keep these local.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_SECONDS=300
API_RATE_LIMIT_PER_MINUTE=120
